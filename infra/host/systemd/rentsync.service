# Renders secrets from SSM and starts the host's Compose stack on every boot (US5 AC5).
[Unit]
Description=RentSync stack
Requires=rentsync-boot.service docker.service
After=rentsync-boot.service docker.service network-online.target
Wants=network-online.target
# Keep retrying a failed start (a not-yet-effective IAM policy, a registry hiccup): with no
# retry, one transient failure would leave the host stopped until someone intervened (US5 AC5).
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/rentsync-start
TimeoutStartSec=900
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target

# Environment host TLS proxy (feature 002 research R7, R13). Installed as /opt/rentsync/Caddyfile.
# Caddy obtains and renews the certificate itself and redirects HTTP to HTTPS (FR-014).
{
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA}
}

{$SITE_HOSTNAME} {
	# The Collector scrapes /metrics over the Compose network; it is not public.
	respond /metrics 404

	reverse_proxy mock_pms:4001
}

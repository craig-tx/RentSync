# Environment host TLS proxy (feature 002 research R7, R13). Installed as /opt/rentsync/Caddyfile.
# Caddy obtains and renews the certificate itself and redirects HTTP to HTTPS (FR-014).
{
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA}
}

{$SITE_HOSTNAME} {
	# The Collector scrapes /metrics over the Compose network; it is not public. The wildcard
	# also covers Grape's format suffixes such as /metrics.json.
	respond /metrics* 404

	reverse_proxy mock_pms:4001
}

# RentSync (feature 003 contracts/host-changes.md), on the same Elastic IP with its own
# certificate. /metrics is scraped over the Compose network only, as for the mock.
{$APP_HOSTNAME} {
	respond /metrics* 404

	reverse_proxy api:4002
}

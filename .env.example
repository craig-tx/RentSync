# Copy to .env for local development. Never commit .env. No real secrets belong here.

# --- Mock PMS: storage ---
DATABASE_URL=postgres://postgres:postgres@postgres:5432/mock_pms_local_dev
TEST_DATABASE_URL=postgres://postgres:postgres@postgres:5432/mock_pms_local_dev_test
REDIS_URL=redis://redis:6379/0

# --- Mock PMS: admin ---
# Bearer token for /admin/* (compared in constant time).
ADMIN_TOKEN=change-me-admin-token

# --- Mock PMS: seed ---
SEED=42
# Empty means "today" (UTC). Set to a fixed date for reproducible data across days.
SEED_ANCHOR_DATE=

# --- Mock PMS: OAuth ---
ACCESS_TOKEN_TTL=300
REFRESH_TOKEN_TTL=2592000

# --- Mock PMS: limits and delivery ---
RATE_LIMIT_PER_MINUTE=60
RETRY_BASE_SECONDS=2
MAX_ATTEMPTS=8
METRICS_FLUSH_INTERVAL_S=5

# --- Telemetry ---
DEPLOYMENT_ENVIRONMENT=local
# DeploymentId (constitution VI): names this stack; carried as deployment.id on all telemetry.
# Database names above derive from it (hyphens become underscores).
DEPLOYMENT_ID=local-dev
# OTLP/HTTP endpoint the Collector exports to (configuration only, constitution VI).
OPENOBSERVE_OTLP_ENDPOINT=http://openobserve:5080/api/default
OPENOBSERVE_USER=admin@example.com
# OpenObserve requires 8-128 chars with upper, lower, digit and special character.
OPENOBSERVE_PASSWORD=Change-me-0penObserve!

# --- Test receiver (tools profile) ---
# Set to a client's signing_secret before starting the receiver.
RECEIVER_SECRET=
# Number of initial deliveries the receiver answers with 500.
RECEIVER_FAIL_FIRST=0

# --- RentSync API (feature 003; specs/003-pms-ingestion/plan.md "Configuration") ---
RENTSYNC_DATABASE_URL=postgres://postgres:postgres@postgres:5432/rentsync_local_dev
RENTSYNC_TEST_DATABASE_URL=postgres://postgres:postgres@postgres:5432/rentsync_local_dev_test
# Database 1 of the shared Redis, keys prefixed "rentsync:" (research R13).
RENTSYNC_REDIS_URL=redis://redis:6379/1
# key_id=base64(32 bytes)[,...]; the first encrypts, every listed key decrypts (research R8).
# This key decodes to "DEV-ONLY-KEY-NEVER-USE-ON-A-HOST": it is public, so it MUST NEVER be used
# on a host. Hosts get theirs from SSM (contracts/host-changes.md).
RENTSYNC_ENCRYPTION_KEYS=k1=REVWLU9OTFktS0VZLU5FVkVSLVVTRS1PTi1BLUhPU1Q=
# Sign-in password of the seeded operators (at least 16 characters).
RENTSYNC_OPERATOR_SEED_PASSWORD=local-dev-operator-pass
# Keys the CSRF HMAC (at least 32 URL-safe characters).
RENTSYNC_SESSION_SECRET=local-dev-session-secret-change-me-0123456789
# Where each side is reached (research R13): the browser uses the public URLs, containers the
# internal ones.
PMS_PUBLIC_URL=http://localhost:4001
PMS_API_URL=http://mock_pms:4001
APP_PUBLIC_URL=http://localhost:4002
WEBHOOK_SUBSCRIBER_URL=http://api:4002/webhooks/pms
# Reconciliation (research R5): how often, and how far back each run re-reads.
RECONCILE_INTERVAL_S=900
RECONCILE_OVERLAP_S=3600
# Requests per minute RentSync allows itself against the PMS, below the mock's 60 (research R6).
PMS_RATE_LIMIT_PER_MINUTE=50

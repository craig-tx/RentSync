{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunDeployDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:<aws-region>::document/AWS-RunShellScript"
    },
    {
      "Sid": "OnlyOnProtectedHosts",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:<aws-region>:<aws-account-id>:instance/*",
      "Condition": { "StringEquals": { "ssm:resourceTag/rentsync:deployable": "protected" } }
    },
    {
      "Sid": "ReadCommandResults",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations"],
      "Resource": "*"
    }
  ]
}

#!/usr/bin/env ruby
# frozen_string_literal: true

# Creates the DATABASE_URL and TEST_DATABASE_URL databases if missing, runs migrations,
# and seeds (unless --test-db-only).
#
# --deploy (feature 002 research R10) is the non-destructive variant a release runs on a
# deployed host: it needs only DATABASE_URL, migrates it, and seeds only when it has no
# operators yet, so releases never wipe clients or grants (FR-030).
require "sequel"
require_relative "../config/settings"
require_relative "../lib/mock_pms/db"

test_only = ARGV.include?("--test-db-only")
deploy = ARGV.include?("--deploy")
ENV["SERVICE_NAME"] ||= "mock_pms-tool"

def migrate!(url)
  Sequel.extension :migration
  Sequel.connect(url) do |db|
    Sequel::Migrator.run(db, File.expand_path("../db/migrations", __dir__))
  end
end

def seed!
  require_relative "../lib/mock_pms"
  MockPms.boot!
  return unless defined?(MockPms::Seed::Reset)

  result = MockPms::Seed::Reset.run!(seed: MockPms::Settings.seed, anchor_date: MockPms::Settings.seed_anchor_date)
  puts "seeded: seed=#{result[:seed]} anchor_date=#{result[:anchor_date]} data_digest=#{result[:data_digest]}"
end

if deploy
  url = ENV.fetch("DATABASE_URL")
  MockPms.ensure_database!(url)
  migrate!(url)
  empty = Sequel.connect(url) { |db| db[:operators].empty? }
  seed! if empty
  puts "setup complete (deploy; seeded=#{empty})"
  exit
end

urls = [ENV.fetch("TEST_DATABASE_URL")]
urls.unshift(ENV.fetch("DATABASE_URL")) unless test_only
urls.each do |url|
  MockPms.ensure_database!(url)
  migrate!(url)
end

seed! unless test_only
puts "setup complete (#{test_only ? 'test database only' : 'all databases'})"

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mock PMS · Authorize</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #f4f5f7; color: #1d2433; margin: 0; }
    main { max-width: 420px; margin: 8vh auto; background: #fff; padding: 28px; border-radius: 10px;
           box-shadow: 0 2px 12px rgba(0,0,0,.08); }
    h1 { font-size: 1.25rem; margin: 0 0 4px; }
    p.note { color: #5b6475; font-size: .9rem; margin: 0 0 20px; }
    label { display: block; font-size: .85rem; margin: 12px 0 4px; }
    input[type=text], input[type=password] { width: 100%; padding: 8px; box-sizing: border-box;
           border: 1px solid #c8ccd4; border-radius: 6px; }
    .actions { display: flex; gap: 8px; margin-top: 20px; }
    button { flex: 1; padding: 10px; border-radius: 6px; border: 0; font-weight: 600; cursor: pointer; }
    button[value=approve] { background: #1f6feb; color: #fff; }
    button[value=deny] { background: #e6e8eb; color: #1d2433; }
    .error { background: #fde8e8; color: #9b1c1c; padding: 8px 10px; border-radius: 6px; font-size: .9rem; }
  </style>
</head>
<body>
<main>
  <h1>Authorize <%= h(client.name) %></h1>
  <p class="note">Mock PMS test harness. <strong><%= h(client.name) %></strong> is requesting read access to your portfolio.</p>
  <% if error %><p class="error"><%= h(error) %></p><% end %>
  <form method="post" action="/oauth/authorize">
    <% fields.each do |name, value| %>
      <input type="hidden" name="<%= h(name) %>" value="<%= h(value) %>">
    <% end %>
    <label for="login">Operator login</label>
    <input id="login" name="login" type="text" autocomplete="username" value="<%= h(login) %>" required>
    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>
    <div class="actions">
      <button type="submit" name="decision" value="approve">Approve</button>
      <button type="submit" name="decision" value="deny" formnovalidate>Deny</button>
    </div>
  </form>
</main>
</body>
</html>

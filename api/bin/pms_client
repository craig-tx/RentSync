#!/usr/bin/env ruby
# frozen_string_literal: true

# Inspects or sets RentSync's PMS client (research R9).
#
#   bin/pms_client --show   the active client ID and when it was registered
#   bin/pms_client --set    read client_id=, client_secret= and signing_secret= lines from stdin
#                           (credentials a real PMS hands over out of band) and make them active
#
# Secrets are read from stdin, never from arguments, and never printed.
ENV["SERVICE_NAME"] ||= "rentsync-tool"
require_relative "../lib/rentsync"

Rentsync.boot!
case ARGV.first
when "--show"
  client = Rentsync::PmsClient.active.first(pms_key: Rentsync::Pms::Registration::PMS_KEY)
  abort "no active PMS client; run bin/setup" unless client
  puts "client_id: #{client.client_id}", "registered_at: #{client.registered_at.utc.iso8601}",
       "base_url: #{client.base_url}"
when "--set"
  fields = $stdin.each_line.filter_map { |line| line.strip.split("=", 2) if line.include?("=") }.to_h
  missing = %w[client_id client_secret signing_secret].select { |k| fields[k].to_s.strip.empty? }
  abort "missing on stdin: #{missing.join(', ')}" unless missing.empty?
  result = Rentsync::Pms::Registration.new(admin: nil).install!(
    client_id: fields["client_id"], client_secret: fields["client_secret"], signing_secret: fields["signing_secret"]
  )
  puts "PMS client: #{result[:client_id]} (#{result[:action]})"
else
  abort "usage: bin/pms_client --show | --set < credentials"
end
